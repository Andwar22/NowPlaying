---
import { loadMovies, todayWIB, statusOf, daysLeft, formatDateID } from "../lib/movies";

const movies = loadMovies();
const today = todayWIB();
const playing = movies.filter((m) => statusOf(m, today) === "playing");
const coming = movies.filter((m) => statusOf(m, today) === "coming");
const hero = playing.find((m) => m.backdrop) ?? playing[0] ?? null;

const metaLine = (m: (typeof movies)[number]) =>
  [m.year, m.rating ? `★ ${m.rating.toFixed(1)}` : null, m.runtime ? `${m.runtime} mnt` : null]
    .filter(Boolean)
    .join("  •  ");
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NowPlaying — Jadwal Film Jellyfin</title>
    <meta
      name="description"
      content="Jadwal film yang sedang tayang di server Jellyfin — lengkap dengan batas tayang tiap film."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">
          <span class="brand-mark">▶</span>
          <span class="brand-text">NOW<b>PLAYING</b></span>
        </a>
        <p class="tagline">Jadwal film server Jellyfin</p>
        <input
          id="search"
          class="search"
          type="search"
          placeholder="Cari film…"
          aria-label="Cari film"
        />
      </div>
    </header>

    {
      hero && (
        <section
          class="hero clickable"
          data-id={hero.id}
          tabindex="0"
          role="button"
          aria-label={`Lihat detail ${hero.displayTitle}`}
        >
          {hero.backdrop && (
            <img class="hero-bg" src={hero.backdrop} alt="" loading="eager" />
          )}
          <div class="hero-shade"></div>
          <div class="hero-content">
            <p class="kicker">
              <span class="live-dot"></span> Sedang tayang
            </p>
            <h1>{hero.displayTitle}</h1>
            <p class="hero-meta">{metaLine(hero)}</p>
            {hero.genres.length > 0 && (
              <p class="chips">
                {hero.genres.map((g) => (
                  <span class="chip">{g}</span>
                ))}
              </p>
            )}
            <p
              class="hero-until"
              data-countdown-hero
              data-show-until={hero.showUntil}
            >
              Tayang sampai {formatDateID(hero.showUntil)}
            </p>
          </div>
        </section>
      )
    }

    <main>
      <section id="sec-playing" aria-label="Sedang tayang">
        <div class="sec-head">
          <h2>
            <span class="live-dot sm"></span> Sedang Tayang
          </h2>
          <span class="count" id="count-playing">{playing.length} film</span>
        </div>
        <div class="grid" id="grid-playing">
          {
            playing.map((m) => (
              <article
                class="card"
                data-id={m.id}
                data-title={m.displayTitle.toLowerCase()}
                data-show-from={m.showFrom ?? ""}
                data-show-until={m.showUntil}
                data-status="playing"
                tabindex="0"
                role="button"
                aria-label={`Lihat detail ${m.displayTitle}`}
              >
                <div class="poster-wrap">
                  {m.poster ? (
                    <img
                      class="poster"
                      src={m.poster}
                      alt={`Poster ${m.displayTitle}`}
                      loading="lazy"
                    />
                  ) : (
                    <div class="poster poster-fallback" aria-hidden="true">
                      <span>{m.displayTitle.charAt(0)}</span>
                    </div>
                  )}
                  <span
                    class="badge"
                    data-countdown
                    data-show-until={m.showUntil}
                  >
                    Sisa {daysLeft(m.showUntil, today)} hari
                  </span>
                </div>
                <div class="card-body">
                  <h3>{m.displayTitle}</h3>
                  {metaLine(m) && <p class="meta">{metaLine(m)}</p>}
                  {m.genres.length > 0 && (
                    <p class="chips">
                      {m.genres.slice(0, 2).map((g) => (
                        <span class="chip">{g}</span>
                      ))}
                    </p>
                  )}
                </div>
              </article>
            ))
          }
        </div>
        <p class="empty" id="empty-playing" hidden>
          Tidak ada film yang sedang tayang saat ini.
        </p>
      </section>

      <section id="sec-coming" aria-label="Segera hadir">
        <div class="sec-head">
          <h2>🎬 Segera Hadir</h2>
          <span class="count" id="count-coming">{coming.length} film</span>
        </div>
        <div class="grid" id="grid-coming">
          {
            coming.map((m) => (
              <article
                class="card soon"
                data-id={m.id}
                data-title={m.displayTitle.toLowerCase()}
                data-show-from={m.showFrom ?? ""}
                data-show-until={m.showUntil}
                data-status="coming"
                tabindex="0"
                role="button"
                aria-label={`Lihat detail ${m.displayTitle}`}
              >
                <div class="poster-wrap">
                  {m.poster ? (
                    <img
                      class="poster soon-poster"
                      src={m.poster}
                      alt={`Poster ${m.displayTitle}`}
                      loading="lazy"
                    />
                  ) : (
                    <div
                      class="poster poster-fallback soon-poster"
                      aria-hidden="true"
                    >
                      <span>{m.displayTitle.charAt(0)}</span>
                    </div>
                  )}
                  <span class="badge soon-badge">Coming Soon</span>
                </div>
                <div class="card-body">
                  <h3>{m.displayTitle}</h3>
                  {metaLine(m) && <p class="meta">{metaLine(m)}</p>}
                  {m.genres.length > 0 && (
                    <p class="chips">
                      {m.genres.slice(0, 2).map((g) => (
                        <span class="chip">{g}</span>
                      ))}
                    </p>
                  )}
                  <p class="until">
                    Mulai <b>{formatDateID(m.showFrom!)}</b>
                  </p>
                </div>
              </article>
            ))
          }
        </div>
        <p class="empty" id="empty-coming" hidden>
          Belum ada film yang dijadwalkan.
        </p>
      </section>
    </main>

    <div class="modal-overlay" id="modal-overlay" hidden>
      <div
        class="modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-title"
      >
        <button class="modal-close" id="modal-close" aria-label="Tutup detail">
          ✕
        </button>
        <div class="modal-top" id="modal-top">
          <img class="modal-backdrop" id="modal-backdrop" alt="" />
          <div class="modal-shade"></div>
        </div>
        <div class="modal-body">
          <div class="modal-poster-wrap" id="modal-poster-wrap">
            <img class="modal-poster" id="modal-poster" alt="" />
          </div>
          <div class="modal-info">
            <p class="modal-kicker" id="modal-kicker"></p>
            <h2 id="modal-title"></h2>
            <p class="meta" id="modal-meta"></p>
            <p class="chips" id="modal-genres"></p>
            <p class="modal-overview" id="modal-overview"></p>
            <p class="modal-dates" id="modal-dates"></p>
            <p class="note" id="modal-note" hidden></p>
          </div>
        </div>
      </div>
    </div>

    <script type="application/json" id="movies-data">
      {JSON.stringify(movies).replace(/</g, "\\u003c")}
    </script>

    <footer>
      <p>
        Film otomatis hilang dari halaman ini setelah tanggal tayang berakhir.
        Jadwal dapat berubah sewaktu-waktu.
      </p>
      <p class="attrib">
        Data film oleh
        <a href="https://www.themoviedb.org/" target="_blank" rel="noopener">TMDB</a>.
        This product uses the TMDB API but is not endorsed or certified by TMDB.
      </p>
    </footer>

    <script>
      // Evaluasi ulang tanggal di browser (zona Asia/Jakarta) supaya halaman
      // tetap akurat walau situs tidak di-build ulang setiap hari.
      const today = new Intl.DateTimeFormat("en-CA", {
        timeZone: "Asia/Jakarta",
      }).format(new Date());

      const fmtID = (iso) =>
        new Intl.DateTimeFormat("id-ID", {
          day: "numeric",
          month: "short",
          year: "numeric",
          timeZone: "Asia/Jakarta",
        }).format(new Date(iso + "T00:00:00+07:00"));

      const gridPlaying = document.getElementById("grid-playing");
      const gridComing = document.getElementById("grid-coming");

      document.querySelectorAll(".card").forEach((card) => {
        const until = card.dataset.showUntil;
        const from = card.dataset.showFrom || null;

        // Lewat tanggal tayang → hapus dari halaman
        if (until < today) {
          card.remove();
          return;
        }

        const isPlaying = !from || from <= today;

        // Perbarui badge hitung mundur
        const badge = card.querySelector("[data-countdown]");
        if (badge && isPlaying) {
          const days = Math.max(
            0,
            Math.round(
              (Date.parse(until + "T00:00:00+07:00") -
                Date.parse(today + "T00:00:00+07:00")) /
                86400000
            )
          );
          badge.classList.toggle("urgent", days <= 7);
          badge.textContent =
            days === 0 ? "⛔ Terakhir hari ini!" : `Sisa ${days} hari`;
          const untilEl = card.querySelector(".until b");
          if (untilEl) untilEl.textContent = fmtID(until);
        }

        // Pindahkan kartu antar section bila statusnya berubah
        const target = isPlaying ? gridPlaying : gridComing;
        if (card.parentElement !== target) {
          if (isPlaying) {
            card.dataset.status = "playing";
            card.classList.remove("soon");
            card
              .querySelectorAll(".soon-poster")
              .forEach((el) => el.classList.remove("soon-poster"));
            const sb = card.querySelector(".soon-badge");
            if (sb) {
              sb.className = "badge";
              sb.setAttribute("data-countdown", "");
              sb.setAttribute("data-show-until", until);
              sb.textContent = "Sisa 0 hari";
            }
            const untilP = card.querySelector(".until");
            if (untilP) untilP.innerHTML = `Tayang sampai <b>${fmtID(until)}</b>`;
          } else {
            card.dataset.status = "coming";
          }
          target.appendChild(card);
        }
      });

      const refreshCounts = () => {
        const nP = gridPlaying.children.length;
        const nC = gridComing.children.length;
        document.getElementById("count-playing").textContent = `${nP} film`;
        document.getElementById("count-coming").textContent = `${nC} film`;
        document.getElementById("empty-playing").hidden = nP > 0;
        document.getElementById("empty-coming").hidden = nC > 0;
        const heroEl = document.querySelector(".hero");
        const heroUntil = document.querySelector("[data-countdown-hero]");
        if (heroEl && heroUntil) {
          const u = heroUntil.dataset.showUntil;
          if (u < today) {
            heroEl.remove();
          } else {
            const days = Math.max(
              0,
              Math.round(
                (Date.parse(u + "T00:00:00+07:00") -
                  Date.parse(today + "T00:00:00+07:00")) /
                  86400000
              )
            );
            heroUntil.innerHTML =
              days === 0
                ? `⛔ <b>Terakhir hari ini!</b>`
                : `Tayang sampai <b>${fmtID(u)}</b> — sisa ${days} hari`;
          }
        }
      };
      refreshCounts();

      // ---- Modal detail film ----
      const moviesById = Object.fromEntries(
        JSON.parse(document.getElementById("movies-data").textContent).map(
          (m) => [m.id, m]
        )
      );
      const overlay = document.getElementById("modal-overlay");
      const closeBtn = document.getElementById("modal-close");
      let lastFocused = null;

      const escHtml = (s) =>
        String(s ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");

      function openModal(id) {
        const m = moviesById[id];
        if (!m) return;
        const isPlaying = !m.showFrom || m.showFrom <= today;

        document.getElementById("modal-kicker").textContent = isPlaying
          ? "● Sedang Tayang"
          : "🎬 Segera Hadir";
        document.getElementById("modal-title").textContent = m.displayTitle;
        const metaParts = [
          m.year,
          m.rating ? `★ ${Number(m.rating).toFixed(1)}` : null,
          m.runtime ? `${m.runtime} mnt` : null,
        ].filter(Boolean);
        document.getElementById("modal-meta").textContent =
          metaParts.join("  •  ");
        document.getElementById("modal-genres").innerHTML = (
          m.genres || []
        )
          .map((g) => `<span class="chip">${escHtml(g)}</span>`)
          .join("");
        const ov = document.getElementById("modal-overview");
        ov.textContent = m.overview || "Sinopsis belum tersedia.";
        ov.style.display = m.overview ? "" : "none";

        const days = Math.max(
          0,
          Math.round(
            (Date.parse(m.showUntil + "T00:00:00+07:00") -
              Date.parse(today + "T00:00:00+07:00")) /
              86400000
          )
        );
        document.getElementById("modal-dates").innerHTML = isPlaying
          ? `Tayang sampai <b>${fmtID(m.showUntil)}</b> — sisa ${days} hari`
          : `Mulai tayang <b>${fmtID(m.showFrom)}</b>`;

        const noteEl = document.getElementById("modal-note");
        if (m.note) {
          noteEl.textContent = m.note;
          noteEl.hidden = false;
        } else {
          noteEl.hidden = true;
        }

        const bd = document.getElementById("modal-backdrop");
        document.getElementById("modal-top").style.display = m.backdrop
          ? ""
          : "none";
        if (m.backdrop) {
          bd.src = m.backdrop;
          bd.alt = "";
        }
        const posterWrap = document.getElementById("modal-poster-wrap");
        const poster = document.getElementById("modal-poster");
        if (m.poster) {
          poster.src = m.poster;
          poster.alt = `Poster ${m.displayTitle}`;
          posterWrap.style.display = "";
        } else {
          posterWrap.style.display = "none";
        }

        lastFocused = document.activeElement;
        overlay.hidden = false;
        document.body.style.overflow = "hidden";
        closeBtn.focus();
      }

      function closeModal() {
        overlay.hidden = true;
        document.body.style.overflow = "";
        if (lastFocused) lastFocused.focus();
      }

      closeBtn.addEventListener("click", closeModal);
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closeModal();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !overlay.hidden) closeModal();
      });

      const bindClickable = (el) => {
        el.addEventListener("click", () => openModal(el.dataset.id));
        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            openModal(el.dataset.id);
          }
        });
      };
      document
        .querySelectorAll(".card, .hero.clickable")
        .forEach(bindClickable);

      // Pencarian sederhana
      const search = document.getElementById("search");
      search.addEventListener("input", () => {
        const q = search.value.trim().toLowerCase();
        document.querySelectorAll(".card").forEach((card) => {
          card.style.display =
            !q || card.dataset.title.includes(q) ? "" : "none";
        });
      });
    </script>

    <style>
      :root {
        --bg: #0b0b10;
        --surface: #14141d;
        --surface-2: #1c1c28;
        --text: #f2f2f7;
        --muted: #a1a1b3;
        --accent: #e50914;
        --gold: #f5c518;
        --green: #22c55e;
        --amber: #f59e0b;
        --radius: 14px;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        background: var(--bg);
        color: var(--text);
        font-family:
          system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
        line-height: 1.5;
      }

      /* ── Topbar ─────────────────────────────── */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(11, 11, 16, 0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      }
      .topbar-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0.9rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--text);
      }
      .brand-mark {
        background: var(--accent);
        color: #fff;
        width: 2rem;
        height: 2rem;
        border-radius: 8px;
        display: grid;
        place-items: center;
        font-size: 0.9rem;
      }
      .brand-text {
        font-weight: 800;
        letter-spacing: 0.08em;
        font-size: 1.05rem;
      }
      .brand-text b {
        color: var(--accent);
      }
      .tagline {
        color: var(--muted);
        font-size: 0.85rem;
      }
      .search {
        margin-left: auto;
        background: var(--surface);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--text);
        border-radius: 999px;
        padding: 0.55rem 1.1rem;
        font-size: 0.9rem;
        width: min(260px, 100%);
        outline: none;
      }
      .search:focus {
        border-color: var(--accent);
      }

      /* ── Hero ───────────────────────────────── */
      .hero {
        position: relative;
        min-height: 46vh;
        display: flex;
        align-items: flex-end;
        overflow: hidden;
        background: linear-gradient(135deg, #1a0505, #0b0b10);
      }
      .hero-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.55;
      }
      .hero-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, var(--bg) 4%, transparent 55%);
      }
      .hero-content {
        position: relative;
        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 1.25rem 2.5rem;
        width: 100%;
      }
      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #ffb4b4;
        margin-bottom: 0.6rem;
      }
      .live-dot {
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 0 rgba(229, 9, 20, 0.7);
        animation: pulse 1.8s infinite;
      }
      .live-dot.sm {
        width: 0.55rem;
        height: 0.55rem;
      }
      @keyframes pulse {
        70% {
          box-shadow: 0 0 0 10px rgba(229, 9, 20, 0);
        }
        100% {
          box-shadow: 0 0 0 0 rgba(229, 9, 20, 0);
        }
      }
      .hero h1 {
        font-size: clamp(2rem, 6vw, 3.6rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -0.01em;
        max-width: 16ch;
      }
      .hero-meta {
        color: var(--muted);
        margin-top: 0.6rem;
        font-size: 0.95rem;
      }
      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.7rem;
      }
      .chip {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 999px;
        padding: 0.2rem 0.7rem;
        font-size: 0.75rem;
        color: #d7d7e3;
      }
      .hero-until {
        margin-top: 1rem;
        display: inline-block;
        background: rgba(229, 9, 20, 0.16);
        border: 1px solid rgba(229, 9, 20, 0.5);
        padding: 0.5rem 1rem;
        border-radius: 999px;
        font-size: 0.9rem;
      }
      .hero-until b {
        color: #ffb4b4;
      }

      /* ── Sections & grid ────────────────────── */
      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 1rem;
      }
      section {
        margin-bottom: 3rem;
      }
      .sec-head {
        display: flex;
        align-items: baseline;
        gap: 0.8rem;
        margin-bottom: 1.25rem;
      }
      .sec-head h2 {
        font-size: 1.4rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .count {
        color: var(--muted);
        font-size: 0.85rem;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
        gap: 1.25rem;
      }
      .empty {
        color: var(--muted);
        background: var(--surface);
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: var(--radius);
        padding: 2rem;
        text-align: center;
      }

      /* ── Card ───────────────────────────────── */
      .card {
        background: var(--surface);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: var(--radius);
        overflow: hidden;
        cursor: pointer;
        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }
      .card:hover {
        transform: translateY(-6px);
        border-color: rgba(229, 9, 20, 0.55);
        box-shadow: 0 18px 40px -18px rgba(229, 9, 20, 0.45);
      }
      .poster-wrap {
        position: relative;
        aspect-ratio: 2 / 3;
        background: var(--surface-2);
      }
      .poster {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .poster-fallback {
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #2b0a0a, #101018 60%, #1c1030);
      }
      .poster-fallback span {
        font-size: 4rem;
        font-weight: 800;
        color: rgba(255, 255, 255, 0.22);
      }
      .soon-poster {
        filter: grayscale(0.55) brightness(0.75);
      }
      .badge {
        position: absolute;
        left: 0.6rem;
        bottom: 0.6rem;
        background: rgba(34, 197, 94, 0.92);
        color: #06130a;
        font-weight: 700;
        font-size: 0.72rem;
        padding: 0.28rem 0.65rem;
        border-radius: 999px;
      }
      .badge.urgent {
        background: rgba(229, 9, 20, 0.94);
        color: #fff;
      }
      .soon-badge {
        background: rgba(245, 197, 24, 0.94);
        color: #1a1405;
      }
      .card-body {
        padding: 0.9rem 0.95rem 1.05rem;
      }
      .card-body h3 {
        font-size: 0.98rem;
        font-weight: 700;
        line-height: 1.3;
      }
      .meta {
        color: var(--gold);
        font-size: 0.78rem;
        margin-top: 0.3rem;
        font-weight: 600;
      }
      .card .chips {
        margin-top: 0.5rem;
      }
      .overview {
        color: var(--muted);
        font-size: 0.8rem;
        margin-top: 0.55rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .until {
        margin-top: 0.7rem;
        font-size: 0.8rem;
        color: var(--muted);
      }
      .until b {
        color: var(--text);
      }
      .note {
        margin-top: 0.45rem;
        font-size: 0.75rem;
        color: var(--amber);
      }

      .card:focus-visible,
      .hero.clickable:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }
      .hero.clickable {
        cursor: pointer;
      }

      /* ---- Modal detail film ---- */
      .modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: rgba(4, 4, 10, 0.74);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        display: grid;
        place-items: center;
        padding: 1.25rem;
        overflow-y: auto;
        animation: modalFade 0.2s ease;
      }
      .modal-overlay[hidden] {
        display: none;
      }
      .modal {
        position: relative;
        width: min(680px, 100%);
        margin: auto;
        background: var(--surface);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8);
        animation: modalPop 0.25s ease;
      }
      .modal-close {
        position: absolute;
        top: 0.8rem;
        right: 0.8rem;
        z-index: 2;
        width: 2.2rem;
        height: 2.2rem;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(10, 10, 16, 0.7);
        color: var(--text);
        font-size: 1rem;
        cursor: pointer;
        display: grid;
        place-items: center;
        transition: background 0.2s ease;
      }
      .modal-close:hover {
        background: var(--accent);
        border-color: var(--accent);
      }
      .modal-top {
        position: relative;
        aspect-ratio: 16 / 8;
        background: var(--surface-2);
      }
      .modal-backdrop {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .modal-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to top,
          var(--surface) 4%,
          transparent 55%
        );
      }
      .modal-body {
        display: flex;
        gap: 1.25rem;
        padding: 0 1.5rem 1.6rem;
        margin-top: -3.2rem;
        position: relative;
      }
      .modal-poster-wrap {
        flex: 0 0 150px;
      }
      .modal-poster {
        width: 150px;
        border-radius: 12px;
        display: block;
        box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.12);
      }
      .modal-info {
        flex: 1;
        min-width: 0;
        padding-top: 3.4rem;
      }
      .modal-kicker {
        color: var(--accent);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
      }
      .modal-info h2 {
        font-size: 1.5rem;
        line-height: 1.25;
        margin-bottom: 0.4rem;
      }
      .modal-info .chips {
        margin-top: 0.6rem;
      }
      .modal-overview {
        margin-top: 0.9rem;
        color: #c9c9d6;
        font-size: 0.92rem;
        line-height: 1.7;
      }
      .modal-dates {
        margin-top: 1rem;
        font-size: 0.85rem;
        color: var(--muted);
      }
      .modal-dates b {
        color: var(--text);
      }
      .modal-info .note {
        margin-top: 0.6rem;
      }
      @keyframes modalFade {
        from {
          opacity: 0;
        }
      }
      @keyframes modalPop {
        from {
          opacity: 0;
          transform: translateY(14px) scale(0.98);
        }
      }
      @media (max-width: 560px) {
        .modal-body {
          flex-direction: column;
          margin-top: -2.4rem;
          padding: 0 1.15rem 1.3rem;
        }
        .modal-poster-wrap {
          flex: none;
        }
        .modal-poster {
          width: 110px;
        }
        .modal-info {
          padding-top: 0;
        }
        .modal-info h2 {
          font-size: 1.25rem;
        }
      }

      footer {
        border-top: 1px solid rgba(255, 255, 255, 0.07);
        padding: 1.6rem 1.25rem 2.2rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.82rem;
        max-width: 1200px;
        margin: 0 auto;
      }

      footer .attrib {
        margin-top: 0.55rem;
        font-size: 0.7rem;
        opacity: 0.65;
      }

      footer .attrib a {
        color: inherit;
      }

      @media (max-width: 640px) {
        .grid {
          grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
          gap: 0.9rem;
        }
        .topbar-inner {
          gap: 0.7rem;
        }
        .search {
          width: 100%;
          margin-left: 0;
        }
        .hero {
          min-height: 38vh;
        }
      }
    </style>
  </body>
</html>
